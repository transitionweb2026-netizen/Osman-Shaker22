# Hostinger (Apache / LiteSpeed) settings for the static export.
# Copied into out/ by `npm run build`; upload it together with the rest of out/.

DirectoryIndex index.html
ErrorDocument 404 /404.html

# Correct types for modern assets
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  # HTML is always revalidated so content updates appear immediately.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Every JS, CSS and font file in the export has a content hash in its name.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images keep stable names, so cache them for a shorter period.
  <FilesMatch "\.(webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
