# Copy to .env.production (or .env.local) and fill in before the production build.

# Public origin, used for canonical URLs, Open Graph images, robots.txt and sitemap.xml.
# Placeholder until the domain is known — do not launch with example.com.
NEXT_PUBLIC_SITE_URL=https://example.com

# Pages are "noindex" and robots.txt blocks crawlers until this is "true".
# Set to true for the launch build only: `npm run build` then stops while any placeholder
# remains (list them with npm run check:content).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact form destination (optional). Without it, the form hands the message to
# WhatsApp. With it, the form POSTs JSON (name, phone, email, topic, message, locale)
# to this URL — e.g. a Formspree / Web3Forms form URL or a Supabase Edge Function.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# --- Future Supabase CMS (not used yet — see docs/SUPABASE.md) ---
# Read during `next build` with the public anon key; Row Level Security limits it to published rows.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never add the service-role key here or anywhere in this frontend.
